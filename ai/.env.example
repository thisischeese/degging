# ---------------------------------------------------------------
# Docker Compose 기준 AI 서버 예시값
# 실제 사용 시 루트 .env의 DB 계정/비밀번호/DB명과 동일하게 맞춰야 합니다.
# ---------------------------------------------------------------

# PostgreSQL
POSTGRES_HOST=postgres-container
POSTGRES_PORT=5432
POSTGRES_DB=your_postgres_db
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

# MongoDB
MONGO_HOST=mongo-container
MONGO_PORT=27017
MONGO_USERNAME=your_mongo_username
MONGO_PASSWORD=your_mongo_password
MONGO_DATABASE=your_mongo_database

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DISCOVERY_LOG_LEVEL=DEBUG
# Keep WEB_CONCURRENCY unset so uvicorn stays single-process.
# WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=300
GUNICORN_GRACEFUL_TIMEOUT=60
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=200
GUNICORN_MAX_REQUESTS_JITTER=20

S3_SECRET_KEY=your_s3_secret_key
S3_ACCESS_KEY=your_s3_access_key
S3_BUCKET_NAME=your_s3_bucket_name
S3_REGION=your_s3_region
GMS_API_KEY=your_gms_api_key

# Cafe crawling
CAFE_BATCH_CONCURRENCY=2
CAFE_TAB_CONCURRENCY=2
CAFE_IMAGE_CONCURRENCY=3
CAFE_HTTP_MAX_CONNECTIONS=30
PROMETHEUS_METRICS_ENABLED=true
# Single-process uvicorn does not need Prometheus multiprocess mode.
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=5
MONGO_MAX_POOL_SIZE=20

HF_TOKEN=your_hf_token
