# ---------------------------------------------------------------
# 로컬 개발: 아래 값을 그대로 사용
# 도커 컴포즈(프로덕션): POSTGRES_HOST=postgres-container
#                        POSTGRES_PORT=5432
# ---------------------------------------------------------------

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---------------------------------------------------------------
# 로컬 개발: 아래 값을 그대로 사용
# 도커 컴포즈(프로덕션): MONGO_HOST=mongo-container
#                        MONGO_PORT=27017
# ---------------------------------------------------------------

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_DATABASE=

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
